<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_attendance_devices" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.attendance.devices</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_attendance']" position="inside">
                <block title="Pointeuses" name="attendance_devices_settings">
                    <setting string="Fuseau horaire des présences"
                             help="Fuseau local utilisé pour les shifts, pauses, absences, statuts et la conversion des pointages. Pour un décalage fixe, indépendant des changements d'heure : Etc/GMT = UTC+0, Etc/GMT-1 = UTC+1 (le signe est inversé, c'est la norme IANA).">
                        <field name="attendance_timezone"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
